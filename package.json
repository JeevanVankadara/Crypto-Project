{
  "name": "academic-sharing-baseline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Academic grade-sheet sharing: Express, local MongoDB, and browser FAME CP-ABE.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "abe:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-go.ps1",
    "abe:build": "node scripts/build-abe.js",
    "abe:setup": "node --env-file-if-exists=.env scripts/setup-abe.js",
    "benchmark": "node scripts/benchmark-abe.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "inspect": "node --env-file-if-exists=.env scripts/inspect.js",
    "db:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-mongodb.ps1",
    "db:start": "node --env-file-if-exists=.env scripts/local-mongodb.js start",
    "db:stop": "node --env-file-if-exists=.env scripts/local-mongodb.js stop",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/*.{html,css,js}\" package.json \"public/abe/{workspace,comparison,worker}.js\" \"public/abe/workspace.css\""
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10"
  }
}
